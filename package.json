{
  "name": "openwebui-omnibox",
  "version": "1.0.2",
  "type": "module",
  "description": "OpenWebUI Omnibox browser extension for Firefox and Chrome",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:chrome": "node scripts/validate-chrome-credentials.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chrome-e2e": "node scripts/chrome-e2e.mjs",
    "postinstall": "wxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jimaldon/openwebui-omnibox.git"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  }
}
